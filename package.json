{
  "name": "ganfan",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "prepare": "husky",
    "eas:update:preview": "eas update --channel preview --message \"preview update\"",
    "eas:update:production": "eas update --channel production --message \"production update\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@supabase/supabase-js": "latest",
    "expo": "~55.0.23",
    "expo-constants": "~55.0.16",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-updates": "latest",
    "react": "19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.83.6",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "^0.21.0",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "eslint": "latest",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "lint-staged": "^16.4.0",
    "typescript": "latest",
    "typescript-eslint": "^8.59.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --max-warnings=0"
  }
}
